{
  "name": "pwa-inspecciones-laboratorio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "npm run test:coverage && npm run test:integration && npm run test:e2e",
    "verify": "node scripts/verify.mjs",
    "lint": "next lint --dir src --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test:legacy": "node scripts/test-node.mjs legacy",
    "test:unit": "node scripts/test-node.mjs unit",
    "test:node": "node scripts/test-node.mjs",
    "test:coverage": "c8 node scripts/test-node.mjs",
    "test:integration": "playwright test --config playwright.integration.config.mjs",
    "test:e2e": "playwright test --config playwright.config.mjs"
  },
  "dependencies": {
    "next": "14.2.35",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/node": "^20.19.43",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "c8": "10.1.3",
    "esbuild": "0.25.11",
    "eslint": "8.57.1",
    "eslint-config-next": "14.2.35",
    "typescript": "^5.4.5"
  },
  "engines": {
    "node": ">=22.22.0 <23",
    "npm": ">=10"
  }
}
